#!/bin/sh
set -eu
cd "$(dirname "$0")"

SDK="/Library/Developer/CommandLineTools/SDKs/MacOSX26.5.sdk"
ZOO="$HOME/node_develop/opencv_clasification_demo/assets/dnn/models.yml"
test -f "$ZOO" || { echo "Missing zoo file: $ZOO"; exit 1; }


# export OPENCV_DOWNLOAD_CACHE_DIR="$CACHE"

cmake -S . -B build \
  -DOpenCV_DIR="$(brew --prefix opencv)/lib/cmake/opencv5" \
  -DCMAKE_OSX_SYSROOT="$SDK"
cmake --build build

exec ./build/object_detection.app/Contents/MacOS/object_detection \
  --zoo="$HOME/node_develop/opencv_clasification_demo/assets/dnn/models.yml" \
  yolov8 \
  --camwidth=640 \
  --camheight=480 \
  --async=1 \
  "$@"