#!/bin/sh
set -eu
cd "$(dirname "$0")"

SDK="/Library/Developer/CommandLineTools/SDKs/MacOSX26.5.sdk"
test -d "$SDK" || { echo "SDK not found: $SDK"; exit 1; }

cmake -S . -B build \
  -DOpenCV_DIR="$(brew --prefix opencv)/lib/cmake/opencv5" \
  -DCMAKE_OSX_SYSROOT="$SDK"
cmake --build build

ROOT="$(pwd)"
export OPENCV_SAMPLES_DATA_PATH="$ROOT/data"
export OPENCV_DOWNLOAD_CACHE_DIR="$ROOT/../../opencv_clasification_demo/assets/dnn"

exec ./build/object_detection.app/Contents/MacOS/object_detection \
  yolov8 \
  --zoo="$ROOT/../../opencv_clasification_demo/assets/dnn/models.yml" \
  --async=1 \
  "$@"